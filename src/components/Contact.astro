---
import { siteData } from '../data/siteData';
---

<section class="section-editorial-dark contact-section" id="contatti" aria-label="Contatti e informazioni di studio">
  <div class="site-container">
    <div class="contact-card reveal-on-scroll">
      <div class="contact-header">
        <span class="section-header-tag">Contatto Diretto</span>
        <h2 class="contact-headline">
          Il prossimo progetto potrebbe iniziare da una <span class="highlight-serif">conversazione.</span>
        </h2>
        <p class="contact-subtext">
          Sia che tu stia pensando a una ristrutturazione completa o a una ridefinizione sartoriale degli arredi, il primo passo è confrontarsi sui vostri desideri.
        </p>
      </div>

      <!-- Action & Details Grid -->
      <div class="contact-content-grid">
        <!-- Direct Phone CTA -->
        <div class="contact-primary-block">
          <span class="block-tag">Chiamata Diretta</span>
          <a href={siteData.professional.phoneHref} class="contact-big-phone" aria-label={`Chiama il numero ${siteData.professional.phone}`}>
            <span class="phone-num">{siteData.professional.phone}</span>
            <span class="phone-call-badge">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path>
              </svg>
              <span>Parliamo della tua casa</span>
            </span>
          </a>
          <p class="phone-hint">Disponibile per colloqui preliminari e appuntamenti in studio o sul cantiere.</p>
        </div>

        <!-- Studio Location & Service Areas -->
        <div class="contact-details-block">
          <div class="detail-row">
            <span class="detail-label">Indirizzo Studio</span>
            <div class="address-box">
              <address class="address-text">
                {siteData.professional.address.street}<br />
                {siteData.professional.address.postalCode} {siteData.professional.address.locality} ({siteData.professional.address.province}), {siteData.professional.address.country}
              </address>
              <a 
                href={siteData.professional.address.mapsUrl} 
                target="_blank" 
                rel="noopener noreferrer" 
                class="map-external-link"
              >
                <span>Apri su Google Maps</span>
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path>
                  <polyline points="15 3 21 3 21 9"></polyline>
                  <line x1="10" y1="14" x2="21" y2="3"></line>
                </svg>
              </a>
            </div>
          </div>

          <div class="detail-row">
            <span class="detail-label">Zone Servite</span>
            <div class="service-areas-pills">
              {siteData.professional.serviceAreas.map((area) => (
                <span class="area-pill">{area}</span>
              ))}
            </div>
          </div>

          <div class="detail-row">
            <span class="detail-label">Piattaforme Professionali</span>
            <a 
              href={siteData.professional.houzzProfileUrl} 
              target="_blank" 
              rel="noopener noreferrer" 
              class="btn btn-outline-light houzz-pro-btn"
            >
              <span>Visualizza Profilo Ufficiale su Houzz</span>
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path>
                <polyline points="15 3 21 3 21 9"></polyline>
                <line x1="10" y1="14" x2="21" y2="3"></line>
              </svg>
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .contact-section {
    border-top: 1px solid var(--color-carbon-border);
    position: relative;
    padding-block: clamp(4rem, 8vw, 8rem);
  }

  .contact-card {
    background-color: var(--color-carbon-surface);
    border: 1px solid var(--color-carbon-border-strong);
    border-radius: var(--radius-xs);
    padding: clamp(2.5rem, 5vw, 5rem);
    display: flex;
    flex-direction: column;
    gap: clamp(2.5rem, 4vw, 4rem);
  }

  .contact-header {
    max-width: 820px;
  }

  .contact-headline {
    font-size: clamp(2.25rem, 4vw + 0.5rem, 4rem);
    font-weight: 500;
    line-height: 1.1;
    letter-spacing: -0.025em;
    color: var(--color-white);
    margin-bottom: 1.5rem;
    text-wrap: balance;
  }

  .highlight-serif {
    font-family: var(--font-serif);
    font-style: italic;
    color: var(--color-terracotta);
  }

  .contact-subtext {
    font-size: 1.125rem;
    line-height: 1.6;
    color: var(--color-stone-300);
    max-width: 60ch;
  }

  .contact-content-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: clamp(2.5rem, 5vw, 4rem);
    padding-top: 2rem;
    border-top: 1px solid var(--color-carbon-border);
  }

  @media (min-width: 900px) {
    .contact-content-grid {
      grid-template-columns: 1.2fr 1fr;
    }
  }

  .contact-primary-block {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .block-tag {
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.16em;
    color: var(--color-terracotta);
  }

  .contact-big-phone {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    padding: 2rem;
    background-color: rgba(255, 255, 255, 0.03);
    border: 1px solid var(--color-carbon-border);
    border-radius: var(--radius-xs);
    transition: all var(--transition-base);
  }

  .contact-big-phone:hover {
    background-color: var(--color-carbon-subtle);
    border-color: var(--color-terracotta);
    transform: translateY(-2px);
  }

  .phone-num {
    font-size: clamp(1.85rem, 3.2vw + 0.5rem, 2.75rem);
    font-weight: 700;
    letter-spacing: -0.02em;
    color: var(--color-white);
    font-family: var(--font-sans);
  }

  .phone-call-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;
    font-size: 0.9375rem;
    font-weight: 500;
    color: var(--color-terracotta);
  }

  .phone-hint {
    font-size: 0.875rem;
    color: var(--color-stone-500);
    line-height: 1.5;
  }

  /* Details Block */
  .contact-details-block {
    display: flex;
    flex-direction: column;
    gap: 2rem;
    justify-content: center;
  }

  .detail-row {
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
  }

  .detail-label {
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--color-stone-500);
  }

  .address-box {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .address-text {
    font-style: normal;
    font-size: 1rem;
    line-height: 1.5;
    color: var(--color-stone-100);
  }

  .map-external-link {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.8125rem;
    color: var(--color-terracotta);
    transition: color var(--transition-fast);
  }

  .map-external-link:hover {
    color: var(--color-white);
  }

  .service-areas-pills {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
  }

  .area-pill {
    font-size: 0.8125rem;
    padding: 0.4rem 0.85rem;
    border-radius: var(--radius-xs);
    background-color: rgba(255, 255, 255, 0.05);
    border: 1px solid var(--color-carbon-border);
    color: var(--color-stone-300);
  }

  .houzz-pro-btn {
    align-self: flex-start;
    padding: 0.75rem 1.25rem;
    font-size: 0.8125rem;
  }
</style>
