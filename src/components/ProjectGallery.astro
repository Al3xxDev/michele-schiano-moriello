            </div>
            <figcaption class="gallery-caption">
              <span class="caption-num">05</span>
              <div class="caption-text">
                <strong class="caption-title">{photoAssets[3].title}</strong>
                <p>{photoAssets[3].caption}</p>
              </div>
            </figcaption>
          </figure>
        </div>
      </div>

      <!-- 4. Transitional Circulation & Work (Image 5 & Image 10) -->
      <div class="gallery-grid-2col">
        <!-- Corridor Art Gallery (Image 5) -->
        <div class="gallery-block reveal-on-scroll delay-100">
          <figure class="gallery-figure">
            <div class="img-zoom-container">
              <Image 
                src={photoAssets[4].asset} 
