              <div class="caption-text">
                <strong class="caption-title">{photoAssets[9].title}</strong>
                <p>{photoAssets[9].caption}</p>
              </div>
            </figcaption>
          </figure>
        </div>
      </div>

      <!-- 5. Master Suite Suite & Bed (Image 7 & Image 8) -->
      <div class="gallery-grid-unequal">
        <!-- Master Bedroom Panoramic (Image 7 - Wide Landscape) -->
        <div class="gallery-block span-wide reveal-on-scroll delay-100">
          <figure class="gallery-figure">
            <div class="img-zoom-container">
              <Image 
                src={photoAssets[6].asset} 
                alt={photoAssets[6].alt}
                widths={[640, 1024, 1600]}
                sizes="(min-width: 900px) 60vw, 95vw"
                class="gallery-image"
                loading="lazy"
