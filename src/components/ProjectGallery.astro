              >
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <polyline points="15 3 21 3 21 9"></polyline>
                  <polyline points="9 21 3 21 3 15"></polyline>
                  <line x1="21" y1="3" x2="14" y2="10"></line>
                  <line x1="3" y1="21" x2="10" y2="14"></line>
                </svg>
              </button>
            </div>
            <figcaption class="gallery-caption">
              <span class="caption-num">04</span>
              <div class="caption-text">
                <strong class="caption-title">{photoAssets[5].title}</strong>
                <p>{photoAssets[5].caption}</p>
              </div>
            </figcaption>
          </figure>
        </div>

        <!-- Kitchen Peninsula (Image 4 - Portrait) -->
        <div class="gallery-block reveal-on-scroll delay-200">
          <figure class="gallery-figure">
            <div class="img-zoom-container">
              <Image 
                src={photoAssets[3].asset} 
                alt={photoAssets[3].alt}
                widths={[480, 800, 1100]}
                sizes="(min-width: 900px) 45vw, 95vw"
