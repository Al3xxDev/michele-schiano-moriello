---
import { Image } from 'astro:assets';
import { siteData } from '../data/siteData';

// Import local image assets for Astro/Sharp optimization
import img1 from '../assets/images/Armonia-di-colori-e-funzionalita1.png';
import img2 from '../assets/images/Armonia-di-colori-e-funzionalita2.png';
import img3 from '../assets/images/Armonia-di-colori-e-funzionalita3.png';
import img4 from '../assets/images/Armonia-di-colori-e-funzionalita4.png';
import img5 from '../assets/images/Armonia-di-colori-e-funzionalita5.png';
import img6 from '../assets/images/Armonia-di-colori-e-funzionalita6.png';
import img7 from '../assets/images/Armonia-di-colori-e-funzionalita7.png';
import img8 from '../assets/images/Armonia-di-colori-e-funzionalita8.png';
import img9 from '../assets/images/Armonia-di-colori-e-funzionalita9.png';
import img10 from '../assets/images/Armonia-di-colori-e-funzionalita10.png';
import img11 from '../assets/images/Armonia-di-colori-e-funzionalita11.png';

// Map metadata to asset
const photoAssets = [
  { ...siteData.photos[0], asset: img2, globalIdx: 0 },
  { ...siteData.photos[1], asset: img3, globalIdx: 1 },
  { ...siteData.photos[2], asset: img1, globalIdx: 2 },
  { ...siteData.photos[3], asset: img4, globalIdx: 3 },
  { ...siteData.photos[4], asset: img5, globalIdx: 4 },
  { ...siteData.photos[5], asset: img6, globalIdx: 5 },
  { ...siteData.photos[6], asset: img7, globalIdx: 6 },
  { ...siteData.photos[7], asset: img8, globalIdx: 7 },
  { ...siteData.photos[8], asset: img9, globalIdx: 8 },
  { ...siteData.photos[9], asset: img10, globalIdx: 9 },
  { ...siteData.photos[10], asset: img11, globalIdx: 10 },
];
---

<section class="section-editorial-dark project-section" id="progetto" aria-label="Progetto in evidenza">
  <div class="site-container">
    <!-- Project Header & Editorial Statement -->
    <div class="project-header">
      <div class="project-meta-top reveal-on-scroll">
        <span class="section-header-tag">Progetto in Evidenza</span>
        <span class="project-category">{siteData.project.category}</span>
      </div>

      <div class="project-title-grid">
        <h2 class="project-title reveal-on-scroll delay-100">
          {siteData.project.title}
        </h2>
        <div class="project-lead-wrapper reveal-on-scroll delay-200">
          <p class="project-lead">
            {siteData.project.lead}
          </p>
          <p class="project-description">
            {siteData.project.description}
          </p>
          <div class="project-specs">
            <span class="spec-label">Ambito:</span>
            <span class="spec-value">{siteData.project.scope}</span>
          </div>
        </div>
      </div>
    </div>

    <!-- Editorial Asymmetrical Photographic Journey -->
    <div class="project-gallery-curation">
      <!-- 1. The Panoramic Lead Statement (Image 2) -->
      <div class="gallery-block block-lead reveal-on-scroll">
        <figure class="gallery-figure">
          <div class="img-zoom-container">
            <Image 
              src={photoAssets[0].asset} 
              alt={photoAssets[0].alt}
              widths={[640, 1024, 1600, 2089]}
              sizes="(min-width: 1440px) 1400px, 95vw"
              class="gallery-image"
              loading="lazy"
              decoding="async"
            />
            <button 
              type="button" 
              class="expand-trigger-btn" 
              data-lightbox-index="0"
              aria-label={`Ingrandisci a schermo intero: ${photoAssets[0].title}`}
            >
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <polyline points="15 3 21 3 21 9"></polyline>
                <polyline points="9 21 3 21 3 15"></polyline>
                <line x1="21" y1="3" x2="14" y2="10"></line>
                <line x1="3" y1="21" x2="10" y2="14"></line>
              </svg>
            </button>
          </div>
          <figcaption class="gallery-caption">
            <span class="caption-num">01</span>
            <div class="caption-text">
              <strong class="caption-title">{photoAssets[0].title}</strong>
              <p>{photoAssets[0].caption}</p>
            </div>
          </figcaption>
        </figure>
      </div>

      <!-- 2. Asymmetric Diptych: Living Room TV & Dining Portal (Image 1 & Image 2) -->
      <div class="gallery-grid-2col">
        <!-- Dining Portal (Image 1 - Portrait) -->
        <div class="gallery-block reveal-on-scroll delay-100">
          <figure class="gallery-figure">
            <div class="img-zoom-container">
              <Image 
                src={photoAssets[2].asset} 
                alt={photoAssets[2].alt}
                widths={[480, 800, 1100]}
                sizes="(min-width: 900px) 45vw, 95vw"
                class="gallery-image"
                loading="lazy"
                decoding="async"
              />
              <button 
                type="button" 
                class="expand-trigger-btn" 
                data-lightbox-index="2"
                aria-label={`Ingrandisci a schermo intero: ${photoAssets[2].title}`}
              >
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <polyline points="15 3 21 3 21 9"></polyline>
                  <polyline points="9 21 3 21 3 15"></polyline>
                  <line x1="21" y1="3" x2="14" y2="10"></line>
                  <line x1="3" y1="21" x2="10" y2="14"></line>
                </svg>
              </button>
            </div>
            <figcaption class="gallery-caption">
              <span class="caption-num">02</span>
              <div class="caption-text">
                <strong class="caption-title">{photoAssets[2].title}</strong>
                <p>{photoAssets[2].caption}</p>
              </div>
            </figcaption>
          </figure>
        </div>

        <!-- TV Cannettato Wall (Image 3 - Landscape) -->
        <div class="gallery-block reveal-on-scroll delay-200">
          <figure class="gallery-figure">
            <div class="img-zoom-container">
              <Image 
                src={photoAssets[1].asset} 
                alt={photoAssets[1].alt}
                widths={[640, 1024, 1400]}
                sizes="(min-width: 900px) 50vw, 95vw"
                class="gallery-image"
                loading="lazy"
                decoding="async"
              />
              <button 
                type="button" 
                class="expand-trigger-btn" 
                data-lightbox-index="1"
                aria-label={`Ingrandisci a schermo intero: ${photoAssets[1].title}`}
              >
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <polyline points="15 3 21 3 21 9"></polyline>
                  <polyline points="9 21 3 21 3 15"></polyline>
                  <line x1="21" y1="3" x2="14" y2="10"></line>
                  <line x1="3" y1="21" x2="10" y2="14"></line>
                </svg>
              </button>
            </div>
            <figcaption class="gallery-caption">
              <span class="caption-num">03</span>
              <div class="caption-text">
                <strong class="caption-title">{photoAssets[1].title}</strong>
                <p>{photoAssets[1].caption}</p>
              </div>
            </figcaption>
          </figure>
        </div>
      </div>

      <!-- 3. Culinary & Craft Details (Image 4 & Image 6) -->
      <div class="gallery-grid-2col reverse-order">
        <!-- Detail Sliding Doors (Image 6 - Portrait) -->
        <div class="gallery-block reveal-on-scroll delay-100">
          <figure class="gallery-figure">
            <div class="img-zoom-container">
              <Image 
                src={photoAssets[5].asset} 
                alt={photoAssets[5].alt}
                widths={[480, 800, 1100]}
                sizes="(min-width: 900px) 45vw, 95vw"
