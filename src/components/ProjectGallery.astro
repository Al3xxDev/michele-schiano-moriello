      <!-- 6. Architectural Bathrooms (Image 9 & Image 11) -->
      <div class="gallery-grid-2col">
        <!-- Terracotta Vanity (Image 9) -->
        <div class="gallery-block reveal-on-scroll delay-100">
          <figure class="gallery-figure">
            <div class="img-zoom-container">
              <Image 
                src={photoAssets[8].asset} 
