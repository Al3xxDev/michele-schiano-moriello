              />
              <button 
                type="button" 
                class="expand-trigger-btn" 
                data-lightbox-index="6"
                aria-label={`Ingrandisci a schermo intero: ${photoAssets[6].title}`}
              >
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <polyline points="15 3 21 3 21 9"></polyline>
                  <polyline points="9 21 3 21 3 15"></polyline>
                  <line x1="21" y1="3" x2="14" y2="10"></line>
                  <line x1="3" y1="21" x2="10" y2="14"></line>
                </svg>
              </button>
            </div>
            <figcaption class="gallery-caption">
              <span class="caption-num">08</span>
              <div class="caption-text">
                <strong class="caption-title">{photoAssets[6].title}</strong>
                <p>{photoAssets[6].caption}</p>
              </div>
            </figcaption>
          </figure>
        </div>

        <!-- Bed Alcove (Image 8 - Portrait) -->
        <div class="gallery-block span-narrow reveal-on-scroll delay-200">
          <figure class="gallery-figure">
            <div class="img-zoom-container">
              <Image 
                src={photoAssets[7].asset} 
                alt={photoAssets[7].alt}
                widths={[480, 800, 1100]}
                sizes="(min-width: 900px) 35vw, 95vw"
                class="gallery-image"
                loading="lazy"
