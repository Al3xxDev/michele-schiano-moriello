<style>
  .project-section {
    position: relative;
    border-top: 1px solid var(--color-carbon-border);
  }

  .project-header {
    margin-bottom: clamp(3rem, 6vw, 6rem);
  }

  .project-meta-top {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    margin-bottom: 1.25rem;
  }

  .project-category {
    font-size: 0.8125rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-stone-500);
  }

  .project-title-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
  }

  @media (min-width: 992px) {
    .project-title-grid {
      grid-template-columns: 1.2fr 1fr;
      align-items: baseline;
    }
  }

  .project-title {
    font-size: clamp(2.25rem, 4.5vw + 0.5rem, 4.5rem);
    font-weight: 500;
    line-height: 1.08;
    letter-spacing: -0.03em;
    color: var(--color-white);
  }

  .project-lead-wrapper {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .project-lead {
    font-family: var(--font-serif);
    font-size: clamp(1.2rem, 1.2vw + 0.4rem, 1.45rem);
    line-height: 1.5;
    color: var(--color-stone-100);
    font-style: italic;
  }

  .project-description {
    font-size: 0.9375rem;
    line-height: 1.65;
    color: var(--color-stone-300);
  }

  .project-specs {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.8125rem;
    color: var(--color-stone-500);
    padding-top: 0.75rem;
    border-top: 1px solid var(--color-carbon-border);
  }

  .spec-label {
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  .spec-value {
    color: var(--color-stone-300);
  }

  /* Gallery Grid System */
  .project-gallery-curation {
    display: flex;
    flex-direction: column;
    gap: clamp(3rem, 6vw, 6rem);
  }

  .gallery-figure {
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .img-zoom-container {
    position: relative;
    overflow: hidden;
    background-color: var(--color-carbon-surface);
    border-radius: var(--radius-xs);
    border: 1px solid var(--color-carbon-border);
  }

  .gallery-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.8s var(--ease-editorial);
  }

  .img-zoom-container:hover .gallery-image {
    transform: scale(1.025);
  }

  .expand-trigger-btn {
    position: absolute;
    bottom: 1rem;
    right: 1rem;
    width: 44px;
    height: 44px;
    background-color: rgba(12, 13, 15, 0.75);
    backdrop-filter: blur(8px);
    border: 1px solid rgba(255, 255, 255, 0.2);
    border-radius: var(--radius-xs);
    color: var(--color-white);
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    opacity: 0.9;
    transition: all var(--transition-fast);
  }

  .expand-trigger-btn:hover {
    background-color: var(--color-terracotta);
    border-color: var(--color-terracotta);
    opacity: 1;
    transform: scale(1.08);
  }

  .gallery-caption {
    display: flex;
    align-items: baseline;
    gap: 1rem;
    padding-inline: 0.25rem;
  }

  .caption-num {
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--color-terracotta);
    font-family: var(--font-sans);
  }

  .caption-text {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .caption-title {
    font-size: 0.9375rem;
    font-weight: 500;
    color: var(--color-white);
  }

  .caption-text p {
    font-size: 0.8125rem;
    line-height: 1.5;
    color: var(--color-stone-500);
  }

  /* 2-Column Grid */
  .gallery-grid-2col {
    display: grid;
    grid-template-columns: 1fr;
    gap: clamp(2rem, 4vw, 4rem);
    align-items: center;
  }

  @media (min-width: 768px) {
    .gallery-grid-2col {
      grid-template-columns: 1fr 1fr;
    }
  }

  /* Unequal Grid for Master Suite */
  .gallery-grid-unequal {
    display: grid;
    grid-template-columns: 1fr;
    gap: clamp(2rem, 4vw, 4rem);
    align-items: center;
  }

  @media (min-width: 900px) {
    .gallery-grid-unequal {
      grid-template-columns: 1.35fr 0.85fr;
    }
  }
</style>

<script>
  // Wire expand buttons to Lightbox
  function setupGalleryLightbox() {
    const triggerButtons = document.querySelectorAll<HTMLButtonElement>('.expand-trigger-btn');
    triggerButtons.forEach((btn) => {
      btn.addEventListener('click', () => {
        const indexStr = btn.getAttribute('data-lightbox-index');
        if (indexStr !== null) {
          const index = parseInt(indexStr, 10);
          if (typeof (window as any).openLightbox === 'function') {
            (window as any).openLightbox(index);
          }
        }
      });
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', setupGalleryLightbox);
  } else {
    setupGalleryLightbox();
  }
</script>
