---
import { siteData } from '../data/siteData';
---

<section class="section-editorial-dark services-section" id="servizi" aria-label="Servizi di interior design e progettazione">
  <div class="site-container">
    <div class="services-header">
      <span class="section-header-tag reveal-on-scroll">Servizi Professionali</span>
      <h2 class="section-title reveal-on-scroll delay-100">
        Competenze al servizio <span class="highlight-serif">dell'abitare.</span>
      </h2>
      <p class="section-intro reveal-on-scroll delay-200">
        Dalla consulenza mirata alla regia completa dell'opera: percorsi di progettazione disegnati attorno alla vostra visione.
      </p>
    </div>

    <div class="services-list">
      {siteData.services.map((service, idx) => (
        <article class={`service-item reveal-on-scroll delay-${(idx + 1) * 100}`}>
          <div class="service-left">
            <span class="service-num">{service.num}</span>
            <h3 class="service-title">{service.title}</h3>
          </div>
          <div class="service-right">
            <p class="service-desc">{service.description}</p>
          </div>
          <div class="service-action" aria-hidden="true">
            <span class="service-arrow">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <line x1="5" y1="12" x2="19" y2="12"></line>
                <polyline points="12 5 19 12 12 19"></polyline>
              </svg>
            </span>
          </div>
        </article>
      ))}
    </div>

    <div class="services-footer-cta reveal-on-scroll delay-300">
      <div class="cta-banner">
        <div class="cta-banner-text">
          <h4 class="cta-banner-title">Hai un progetto o un immobile da ripensare?</h4>
          <p class="cta-banner-desc">Possiamo valutare insieme le potenzialità dei vostri spazi con una prima analisi telefonica.</p>
        </div>
        <a href={siteData.professional.phoneHref} class="btn btn-terracotta cta-banner-btn">
          <span>Chiama lo Studio</span>
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path>
          </svg>
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  .services-section {
    border-top: 1px solid var(--color-carbon-border);
    position: relative;
  }

  .services-header {
    max-width: 800px;
    margin-bottom: clamp(3rem, 6vw, 5rem);
  }

  .highlight-serif {
    font-family: var(--font-serif);
    font-style: italic;
    color: var(--color-stone-100);
  }

  .services-list {
    display: flex;
    flex-direction: column;
    border-top: 1px solid var(--color-carbon-border);
  }

  .service-item {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.25rem;
    padding-block: clamp(2rem, 3.5vw, 3rem);
    border-bottom: 1px solid var(--color-carbon-border);
    position: relative;
    transition: background-color var(--transition-base), padding-inline var(--transition-base);
  }

  @media (min-width: 768px) {
    .service-item {
      grid-template-columns: 1.2fr 1.8fr auto;
      align-items: baseline;
      gap: 2rem;
    }
  }

  .service-item:hover {
    background-color: rgba(255, 255, 255, 0.02);
  }

  .service-left {
    display: flex;
    align-items: baseline;
    gap: 1.5rem;
  }

  .service-num {
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--color-terracotta);
    font-family: var(--font-sans);
    min-width: 24px;
  }

  .service-title {
    font-size: clamp(1.25rem, 1.5vw + 0.5rem, 1.75rem);
    font-weight: 500;
    letter-spacing: -0.02em;
    color: var(--color-white);
  }

  .service-right {
    display: flex;
    align-items: center;
  }

  .service-desc {
    font-size: 0.9375rem;
    line-height: 1.65;
    color: var(--color-stone-300);
    max-width: 58ch;
  }

  .service-action {
    display: none;
    align-items: center;
    justify-content: flex-end;
  }

  @media (min-width: 768px) {
    .service-action {
      display: flex;
    }
  }

  .service-arrow {
    width: 40px;
    height: 40px;
    border-radius: var(--radius-xs);
    border: 1px solid var(--color-carbon-border);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--color-stone-500);
    transition: all var(--transition-fast);
  }

  .service-item:hover .service-arrow {
    color: var(--color-white);
    border-color: var(--color-terracotta);
    background-color: var(--color-terracotta-soft);
    transform: translateX(4px);
  }

  /* Footer CTA Banner */
  .services-footer-cta {
    margin-top: clamp(3rem, 6vw, 5rem);
  }

  .cta-banner {
    background: linear-gradient(135deg, var(--color-carbon-surface) 0%, rgba(28, 30, 34, 0.8) 100%);
    border: 1px solid var(--color-carbon-border);
    border-radius: var(--radius-xs);
    padding: clamp(2rem, 4vw, 3rem);
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    align-items: flex-start;
  }

  @media (min-width: 768px) {
    .cta-banner {
      flex-direction: row;
      justify-content: space-between;
      align-items: center;
    }
  }

  .cta-banner-title {
    font-size: clamp(1.25rem, 1.5vw + 0.5rem, 1.65rem);
    font-weight: 500;
    color: var(--color-white);
    margin-bottom: 0.5rem;
    letter-spacing: -0.02em;
  }

  .cta-banner-desc {
    font-size: 0.9375rem;
    color: var(--color-stone-300);
    max-width: 50ch;
  }

  .cta-banner-btn {
    white-space: nowrap;
  }
</style>
