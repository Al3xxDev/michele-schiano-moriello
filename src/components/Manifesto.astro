---
import { siteData } from '../data/siteData';
---

<section class="section-editorial-light manifesto-section" id="manifesto" aria-label="Manifesto dello studio">
  <div class="site-container">
    <div class="manifesto-grid">
      <!-- Left Column: Header and philosophy statement -->
      <div class="manifesto-left">
        <span class="section-header-tag reveal-on-scroll">{siteData.manifesto.tag}</span>
        <h2 class="manifesto-headline reveal-on-scroll delay-100">
          L'equilibrio tra <span class="highlight-serif">forma</span>, <span class="highlight-serif">funzione</span> e autenticità personale.
        </h2>

        <div class="manifesto-metrics reveal-on-scroll delay-200">
          <div class="metric-item">
            <span class="metric-number">2005</span>
            <span class="metric-label">Inizio dell'attività di progettazione</span>
          </div>
          <div class="metric-item">
            <span class="metric-number">4/4</span>
            <span class="metric-label">Valutazioni 5 stelle su Houzz</span>
          </div>
          <div class="metric-item">
            <span class="metric-number">100%</span>
            <span class="metric-label">Soluzioni sartoriali su misura</span>
          </div>
        </div>
      </div>

      <!-- Right Column: Editorial narrative & pullquote -->
      <div class="manifesto-right">
        <div class="manifesto-card reveal-on-scroll delay-200">
          <div class="quote-mark" aria-hidden="true">“</div>
          <p class="manifesto-text lead-text">
            {siteData.manifesto.paragraphs[0]}
          </p>
          <p class="manifesto-text">
            {siteData.manifesto.paragraphs[1]}
          </p>
          
          <div class="manifesto-author-sign">
            <div class="sign-line"></div>
            <span class="sign-name">Michele Schiano Moriello</span>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .manifesto-section {
    border-top: 1px solid var(--color-ivory-border);
    position: relative;
  }

  .manifesto-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: clamp(2.5rem, 5vw, 5rem);
    align-items: center;
  }

  @media (min-width: 992px) {
    .manifesto-grid {
      grid-template-columns: 1.1fr 0.9fr;
    }
  }

  .manifesto-left {
    display: flex;
    flex-direction: column;
  }

  .manifesto-headline {
    font-size: clamp(2.25rem, 3.8vw + 0.5rem, 3.75rem);
    font-weight: 500;
    line-height: 1.12;
    letter-spacing: -0.025em;
    color: var(--color-stone-900);
    margin-bottom: clamp(2rem, 4vw, 3.5rem);
    text-wrap: balance;
  }

  .highlight-serif {
    font-family: var(--font-serif);
    font-style: italic;
    font-weight: 400;
    color: var(--color-terracotta);
  }

  .manifesto-metrics {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(130px, 1fr));
    gap: 1.5rem;
    padding-top: 2rem;
    border-top: 1px solid var(--color-ivory-border-strong);
  }

  .metric-item {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .metric-number {
    font-size: clamp(1.75rem, 2vw + 1rem, 2.5rem);
    font-weight: 600;
    letter-spacing: -0.03em;
    color: var(--color-stone-900);
    font-family: var(--font-sans);
  }

  .metric-label {
    font-size: 0.8125rem;
    line-height: 1.4;
    color: var(--color-stone-500);
  }

  .manifesto-right {
    position: relative;
  }

  .manifesto-card {
    background-color: var(--color-white);
    padding: clamp(2rem, 4vw, 3.5rem);
    border: 1px solid var(--color-ivory-border);
    box-shadow: 0 12px 32px -8px rgba(0, 0, 0, 0.04);
    position: relative;
    border-radius: var(--radius-xs);
  }

  .quote-mark {
    font-family: var(--font-serif);
    font-size: 5rem;
    line-height: 1;
    color: var(--color-terracotta);
    opacity: 0.25;
    position: absolute;
    top: 1rem;
    left: 1.75rem;
    pointer-events: none;
  }

  .manifesto-text {
    position: relative;
    z-index: 1;
    font-size: 1.0625rem;
    line-height: 1.75;
    color: var(--color-stone-700);
    margin-bottom: 1.25rem;
  }

  .manifesto-text.lead-text {
    font-family: var(--font-serif);
    font-size: clamp(1.2rem, 1.2vw + 0.5rem, 1.4rem);
    line-height: 1.55;
    color: var(--color-stone-900);
    font-style: italic;
  }

  .manifesto-author-sign {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-top: 2rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--color-ivory-border);
  }

  .sign-line {
    width: 24px;
    height: 1px;
    background-color: var(--color-terracotta);
  }

  .sign-name {
    font-size: 0.875rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-stone-900);
  }
</style>
