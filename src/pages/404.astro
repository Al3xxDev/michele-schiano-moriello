---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<BaseLayout
  title="Pagina non trovata — 404 | Michele Schiano Moriello"
  description="La pagina richiesta non è stata trovata."
  canonicalPath="/404"
>
  <Header slot="header" />

  <section class="not-found-section">
    <div class="not-found-container">
      <span class="error-badge">404 — Spazio Non Trovato</span>
      <h1 class="error-title">Pagina Non Trovata</h1>
      <p class="error-text">
        La risorsa che stai cercando non esiste o è stata spostata all'interno del progetto.
      </p>
      <div class="error-action">
        <a href="/" class="btn-return">Torna alla Home</a>
      </div>
    </div>
  </section>

  <Footer slot="footer" />
</BaseLayout>

<style>
  .not-found-section {
    min-height: 65vh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: var(--space-3xl) var(--container-padding);
    background-color: var(--color-carbon-black);
    color: var(--color-ivory);
    text-align: center;
  }

  .not-found-container {
    max-width: 580px;
    margin: 0 auto;
  }

  .error-badge {
    display: inline-block;
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--color-terracotta);
    margin-bottom: var(--space-sm);
  }

  .error-title {
    font-family: var(--font-serif);
    font-size: clamp(2.5rem, 5vw, 4rem);
    font-weight: 400;
    line-height: 1.15;
    margin-bottom: var(--space-md);
  }

  .error-text {
    font-size: 1.0625rem;
    color: var(--color-stone-300);
    line-height: 1.6;
    margin-bottom: var(--space-xl);
  }

  .btn-return {
    display: inline-block;
    padding: 14px 32px;
    background-color: var(--color-terracotta);
    color: #ffffff;
    text-decoration: none;
    font-size: 0.875rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    border-radius: var(--radius-xs);
    transition: background-color var(--transition-fast);
  }

  .btn-return:hover,
  .btn-return:focus-visible {
    background-color: var(--color-terracotta-hover);
    outline: 2px solid var(--color-terracotta);
    outline-offset: 4px;
  }
</style>
